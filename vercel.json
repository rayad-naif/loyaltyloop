{
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{views,public}/**"
    }
  },
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/webhook/(.*)", "destination": "/api/index" },
    { "source": "/oauth/(.*)", "destination": "/api/index" },
    { "source": "/sso/(.*)", "destination": "/api/index" },
    { "source": "/install", "destination": "/api/index" },
    { "source": "/app", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/((?!app|api|webhook|oauth|sso|install|health).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'"
        }
      ]
    }
  ]
}

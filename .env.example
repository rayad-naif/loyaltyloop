# ============================================================================
# LoyaltyLoop environment variables
# Copy to .env for local dev (`npm run dev` loads it; Node 20.6+. Otherwise use
#   node --env-file=.env server.js ) and set the same keys in your host dashboard.
# ============================================================================

# ---- Public URL of this deployment (no trailing slash) ----------------------
# Vercel and Render are auto-detected. Set this for custom domains / AWS.
APP_BASE_URL=https://loyalty.example.com

# ---- HighLevel Marketplace app (Developer portal -> your app) ---------------
# Advanced Settings -> Auth
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Advanced Settings -> Auth -> Shared Secret (decrypts the in-CRM user session; REQUIRED for the dashboard)
GHL_SHARED_SECRET=
# App ID (used to list installed sub-accounts after an agency install). Optional but recommended.
GHL_APP_ID=
# Redirect URL registered in the app. Defaults to APP_BASE_URL + /oauth/callback/lc
# GHL_REDIRECT_URI=
# Paste the app's "Install link" here to override the one /install builds (optional)
# GHL_INSTALL_URL=
# Version id (the part of the client id before the dash) - only needed when building the install link yourself
# GHL_VERSION_ID=
# Override the scopes in the generated install link (space separated)
# GHL_SCOPES=

# ---- Storage (REQUIRED in production) ---------------------------------------
# Free Redis at https://upstash.com -> create database -> REST API tab.
# On Vercel, adding the Upstash integration injects KV_REST_API_URL/TOKEN, which are also understood.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Secrets (generate once, keep forever) ----------------------------------
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts OAuth tokens at rest. Changing it makes stored tokens unreadable (users must reinstall).
TOKEN_ENC_KEY=
# Signs dashboard session tokens. Changing it just signs everyone out.
SESSION_SECRET=

# ---- Webhook signature verification -----------------------------------------
# HighLevel's Ed25519 public key is built in. Override only if HighLevel rotates it:
# GHL_WEBHOOK_ED25519_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Legacy X-WH-Signature (RSA) support - paste HighLevel's legacy public key if you still receive it:
# GHL_WEBHOOK_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# NEVER set this in production:
# WEBHOOK_VERIFY=off

# ---- Optional ---------------------------------------------------------------
# PORT=3000
# SESSION_TTL_SECONDS=28800
# GHL_API_VERSION=2021-07-28
# Local development only (ignored when NODE_ENV=production): open /app?dev=<locationId> without HighLevel SSO
# ALLOW_DEV_LOCATION=true
